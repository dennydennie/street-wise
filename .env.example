# Deployment template for the API service (staging and production). Set these
# as service variables on the host; never commit real values.
#
# This file is NOT a local `.env`: it validates only with real provider
# credentials. For local development copy `.env.local.example` instead.
#
# Every variable here is read by `apps/api/src/config/env.schema.ts`.
# Staging uses the same variables with NODE_ENV=staging and may use
# PAYNOW_MODE=sandbox (an integration in Paynow test mode).

# ── App ──────────────────────────────────────────────
NODE_ENV=production
APP_NAME=StreetWise ZW
API_PORT=3000
# Public URL of the API; Paynow's result URL is <this>/payments/paynow/result.
API_PUBLIC_BASE_URL=https://api.streetwise.co.zw
# Number of reverse proxies in front of the API (1 on Railway).
TRUST_PROXY_HOPS=1
# Swagger UI is never served in production, whatever this says.
SWAGGER_UI_ENABLED=false
API_JWT_SECRET=<generate-a-random-64-char-string>

# ── Database ─────────────────────────────────────────
DATABASE_URL=<postgres-connection-url>
DATABASE_SSL=true

# ── Redis (reserved; not read yet) ───────────────────
REDIS_URL=<redis-connection-url>

# ── OTP / SMS ────────────────────────────────────────
OTP_PEPPER=<generate-a-random-64-char-string>
# Only `console` exists today and production refuses it: add a real SMS
# provider (apps/api/src/modules/auth/sms) before going live.
SMS_PROVIDER=console

# ── Paynow ───────────────────────────────────────────
# sandbox = integration in Paynow test mode (needs PAYNOW_AUTH_EMAIL); live = real money.
PAYNOW_MODE=live
PAYNOW_INTEGRATION_ID=<paynow-integration-id>
PAYNOW_INTEGRATION_KEY=<paynow-integration-key>
# Required in sandbox: the e-mail the Paynow integration is registered to.
# PAYNOW_AUTH_EMAIL=
# Where the payer lands after the Paynow web checkout (`?ref=SWZ-…` is appended).
PAYNOW_RETURN_URL=https://streetwise.co.zw/payments/return

# ── CORS ─────────────────────────────────────────────
# Browser origins allowed to call the API (comma list, https only).
CORS_ORIGINS=https://streetwise.co.zw

# ── Passkeys (WebAuthn) ──────────────────────────────
# RP id = the domain that serves /.well-known/assetlinks.json.
WEBAUTHN_RP_ID=streetwise.co.zw
WEBAUTHN_RP_NAME=StreetWise ZW
# Exact origins only (no wildcards in production). Android apk-key-hash origins
# are derived from the fingerprints below and need not be listed.
WEBAUTHN_ORIGINS=https://streetwise.co.zw
ANDROID_PACKAGE_NAME=<android-application-id>
# SHA-256 of the release (and Play App Signing) certificates, AA:BB:… comma list.
ANDROID_SHA256_CERT_FINGERPRINTS=<sha256-fingerprint>

# ── Maps (Mapbox; clients fall back to OSM without a public token) ──
MAPBOX_PUBLIC_TOKEN=<mapbox-pk-token>
MAPBOX_STYLE=mapbox/streets-v12
# Secret token for server-side reverse geocoding (GEOCODER=mapbox).
MAPBOX_SECRET_TOKEN=<mapbox-sk-token>
GEOCODER=mapbox

# ── Voice reports & briefings ────────────────────────
# rules | claude (claude falls back to rules on any error; 4 s timeout)
REPORT_ANALYZER=rules
# template | claude (cached 10 min per area and time band; falls back to template)
BRIEFING_WRITER=template
# Required when either of the above is claude.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# none | openai (server fallback for devices without speech recognition)
TRANSCRIPTION_PROVIDER=none
# OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# OTP_DEV_ECHO and FAKE_PAYNOW_AUTO_SETTLE_SECONDS are development-only; production refuses them.
