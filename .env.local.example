# Local development template: `cp .env.local.example .env`, `make up`, `pnpm db:migrate`, `pnpm db:seed`, `pnpm dev`.
#
# Every value matches `docker-compose.yml`, so the copy works unchanged. Nothing
# here is a secret and none of it is accepted in production (the API refuses
# the console SMS sender, fake Paynow and `local`/`test` secrets there).
# The deployment template is `.env.example`.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=StreetWise ZW
API_PORT=4100
# Flutter web / Android emulator reach this (emulator: http://10.0.2.2:4100).
API_PUBLIC_BASE_URL=http://localhost:4100
TRUST_PROXY_HOPS=0
SWAGGER_UI_ENABLED=true
API_JWT_SECRET=local-test-secret-with-enough-length-0000

# ── PostgreSQL (docker-compose: postgres, host port 5436) ──
DATABASE_URL=postgresql://streetwise:streetwise@localhost:5436/streetwise
DATABASE_SSL=false
# Print every SQL statement with its parameters. Development only.
# DATABASE_LOG_QUERIES=true

# ── Redis (docker-compose: redis, host port 6381) ───
# Reserved for rate limiting / queues; the API does not read it yet.
REDIS_URL=redis://localhost:6381

# ── OTP / SMS ────────────────────────────────────────
OTP_PEPPER=local-test-otp-pepper-with-enough-length
# `console` writes the SMS (with the code) to the API log.
SMS_PROVIDER=console

# ── Paynow ───────────────────────────────────────────
# `fake` needs no credentials: complete a payment with
#   POST /payments/<ref>/fake-result {"outcome":"paid"}
# or open the redirectUrl a paynow_web payment returns.
PAYNOW_MODE=fake
PAYNOW_RETURN_URL=streetwise://payments/return
