# Local development template: `cp .env.local.example .env`, `make up`, `pnpm db:migrate`, `pnpm db:seed`,
# optionally `pnpm db:seed:demo`, then `pnpm dev`.
#
# Every value matches `docker-compose.yml`, so the copy works unchanged. Nothing
# here is a secret and none of it is accepted in production (the API refuses
# the console SMS sender, fake Paynow, OTP_DEV_ECHO, auto-settle, localhost
# WebAuthn settings and `local`/`test` secrets there).
# The deployment template is `.env.example`.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=StreetWise ZW
API_PORT=4100
# Flutter web / Android emulator reach this (emulator: http://10.0.2.2:4100).
API_PUBLIC_BASE_URL=http://localhost:4100
TRUST_PROXY_HOPS=0
SWAGGER_UI_ENABLED=true
API_JWT_SECRET=local-test-secret-with-enough-length-0000

# ── PostgreSQL (docker-compose: postgres, host port 5436) ──
DATABASE_URL=postgresql://streetwise:streetwise@localhost:5436/streetwise
DATABASE_SSL=false
# Print every SQL statement with its parameters. Development only.
# DATABASE_LOG_QUERIES=true

# ── Redis (docker-compose: redis, host port 6381) ───
# Reserved for rate limiting / queues; the API does not read it yet.
REDIS_URL=redis://localhost:6381

# ── OTP / SMS ────────────────────────────────────────
OTP_PEPPER=local-test-otp-pepper-with-enough-length
# `console` writes the SMS (with the code) to the API log.
SMS_PROVIDER=console

# ── Paynow ───────────────────────────────────────────
# `fake` needs no credentials: complete a payment with
#   POST /payments/<ref>/fake-result {"outcome":"paid"}
# or open the redirectUrl a paynow_web payment returns.
PAYNOW_MODE=fake
PAYNOW_RETURN_URL=streetwise://payments/return
# Dev only (production refuses it): settle a fake EcoCash payment by itself
# after this many seconds. Wallets ending 0000 fail with "Insufficient balance".
FAKE_PAYNOW_AUTO_SETTLE_SECONDS=6

# ── Dev conveniences ─────────────────────────────────
# Return the SMS code as `devCode` from POST /auth/otp/request. Production refuses it.
OTP_DEV_ECHO=true

# ── CORS ─────────────────────────────────────────────
# Extra browser origins (comma list). Outside production any http://localhost:<port>
# and http://127.0.0.1:<port> is allowed anyway (Flutter web dev server).
CORS_ORIGINS=

# ── Passkeys (WebAuthn) ──────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=StreetWise ZW
# Comma list. `http://localhost:*` (any port) is allowed outside production only.
# Android apk-key-hash origins are derived from ANDROID_SHA256_CERT_FINGERPRINTS.
WEBAUTHN_ORIGINS=http://localhost:*
# Digital Asset Links (/.well-known/assetlinks.json is 404 until both are set).
# ANDROID_PACKAGE_NAME=zw.co.streetwise.app
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:…(32 bytes)

# ── Maps ─────────────────────────────────────────────
# Without a public pk.* token the app uses OpenStreetMap tiles.
# MAPBOX_PUBLIC_TOKEN=pk.…
MAPBOX_STYLE=mapbox/streets-v12
# Server-side only (reverse geocoding when GEOCODER=mapbox).
# MAPBOX_SECRET_TOKEN=sk.…
GEOCODER=none

# ── Voice reports ────────────────────────────────────
# rules = built-in keyword analyzer; claude = Claude with rules as fallback (needs ANTHROPIC_API_KEY).
REPORT_ANALYZER=rules
# template = built-in wording; claude = Claude-written headlines (cached 10 min, template fallback).
BRIEFING_WRITER=template
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# none = phones transcribe on device (POST /transcriptions answers 503); openai = server fallback.
TRANSCRIPTION_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
